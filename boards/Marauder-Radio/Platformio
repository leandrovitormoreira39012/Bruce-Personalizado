[env:teste-tela-apenas]
extends = env:esp32-s3-devkitc-1
board = esp32-s3-devkitc-1
board_build.partitions = custom_16Mb.csv
build_src_filter = ${env.build_src_filter} +<../boards/Marauder-Radio>
build_flags =
    ${env:esp32-s3-devkitc-1.build_flags}
    -D BOARD_HAS_PSRAM=1
    -Iboards/Marauder-Radio
    -DDEVICE_NAME='"Teste Tela"'

    ; --- 1. O Barramento SPI (Os 4 pinos principais que alimentam a tela) ---
    -DSCK=18
    -DMOSI=23
    -DMISO=19
    -DSS=5
    -DSPI_SCK_PIN=18
    -DSPI_MOSI_PIN=23
    -DSPI_MISO_PIN=19
    -DSPI_SS_PIN=5

    ; --- 2. A Configuração do Display ST7789 ---
    -DST7789_DRIVER=1
    -DHAS_SCREEN=1
    -DTFT_WIDTH=240
    -DTFT_HEIGHT=320
    -DUSER_SETUP_LOADED=1
    -DSMOOTH_FONT=1
    -DCGRAM_OFFSET=1
    -DTFT_MISO=SPI_MISO_PIN
    -DTFT_MOSI=SPI_MOSI_PIN
    -DTFT_SCK=SPI_SCK_PIN
    -DTFT_CS=17
    -DTFT_DC=16
    -DTFT_RST=15
    -DTFT_BL=14
